---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const targetUrl = project.subdomainUrl || project.githubUrl || "#";

const categoryLabel = Array.isArray(project.category)
  ? project.category.join(' • ')
  : project.category;
---

<article class="group rounded-xl border border-zinc-200 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-zinc-900/30 p-5 hover:border-zinc-300 dark:hover:border-zinc-700 transition-all flex flex-col justify-between">
  <div>
    <!-- Optional Image Preview -->
    {project.image && (
      <div class="mb-4 overflow-hidden rounded-lg border border-zinc-200/80 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-950 aspect-video">
        <img 
          src={project.image} 
          alt={project.title} 
          class="w-full h-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-300"
          loading="lazy"
        />
      </div>
    )}

    <!-- Category & Status -->
    <div class="flex items-center justify-between gap-2 mb-2.5">
      <span class="text-xs font-mono text-zinc-500 uppercase tracking-wider">{categoryLabel}</span>
      {project.isLive && (
        <span class="inline-flex items-center gap-1.5 text-xs text-emerald-600 dark:text-emerald-400 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Live
        </span>
      )}
    </div>

    <!-- Title & Subdomain Link -->
    <h3 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-1">
      <a href={targetUrl} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-1.5">
        {project.title}
        <span class="text-xs text-zinc-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
      </a>
    </h3>

    <!-- Tagline & Description -->
    <p class="text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">{project.tagline}</p>
    <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed line-clamp-3 mb-3">{project.description}</p>

    <!-- Personal Origin Story ("Why I Built This") -->
    {project.originStory && (
      <div class="mt-3 mb-4 p-3.5 rounded-lg border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-100/50 dark:bg-zinc-800/30">
        <span class="inline-block text-[10px] font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-1 font-medium">
          Why I Built This
        </span>
        <p class="text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed font-serif italic">
          "{project.originStory}"
        </p>
      </div>
    )}
  </div>

  <!-- Tech Stack Pills -->
  <div class="flex flex-wrap gap-1.5 pt-3 border-t border-zinc-200/60 dark:border-zinc-800/60">
    {project.techStack.map(tech => (
      <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-zinc-200/60 dark:bg-zinc-800/60 text-zinc-700 dark:text-zinc-300">
        {tech}
      </span>
    ))}
  </div>
</article>
