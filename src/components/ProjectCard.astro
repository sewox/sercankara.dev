---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const primaryUrl = project.subdomainUrl || project.githubUrl || '#';
---

<div class="group relative flex flex-col justify-between p-5 rounded-lg border border-neutral-200/80 dark:border-neutral-800/80 bg-white dark:bg-neutral-900/30 hover:border-neutral-400 dark:hover:border-neutral-700 transition-all">
  <div>
    <!-- Top Row: Category & Subdomain / Live Pill -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-[11px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
        {project.category}
      </span>

      {
        project.subdomainUrl ? (
          <a
            href={project.subdomainUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 font-mono text-[11px] px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors"
          >
            <span>{new URL(project.subdomainUrl).hostname.replace('.sercankara.dev', '')}</span>
            <span class="text-neutral-400">↗</span>
          </a>
        ) : (
          project.isLive && (
            <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-emerald-600 dark:text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Live
            </span>
          )
        )
      }
    </div>

    <!-- Title & Tagline -->
    <h3 class="text-[1.05rem] font-medium text-neutral-900 dark:text-neutral-100 group-hover:text-neutral-700 dark:group-hover:text-neutral-200 transition-colors">
      <a
        href={primaryUrl}
        target={primaryUrl.startsWith('http') ? '_blank' : '_self'}
        rel={primaryUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
        class="focus:outline-none focus-visible:underline"
      >
        {project.title}
      </a>
    </h3>

    <p class="mt-1 text-xs font-mono text-neutral-500 dark:text-neutral-400">
      {project.tagline}
    </p>

    <!-- Detailed Description -->
    <p class="mt-3 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal">
      {project.description}
    </p>
  </div>

  <!-- Tech Stack Badges & Links -->
  <div class="mt-5 pt-4 border-t border-neutral-100 dark:border-neutral-800/60 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap gap-1.5">
      {
        project.techStack.map((tech) => (
          <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-neutral-50 dark:bg-neutral-800/60 text-neutral-500 dark:text-neutral-400 border border-neutral-200/50 dark:border-neutral-800">
            {tech}
          </span>
        ))
      }
    </div>

    {
      project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-mono text-neutral-400 hover:text-neutral-800 dark:hover:text-neutral-200 transition-colors flex items-center gap-1"
          aria-label={`View ${project.title} source code on GitHub`}
        >
          <span>code</span>
          <span>↗</span>
        </a>
      )
    }
  </div>
</div>
