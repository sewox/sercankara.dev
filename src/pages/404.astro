---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found"
  description="The requested page could not be found."
>
  <div class="py-20 text-center space-y-6">
    <span class="font-mono text-xs px-2 py-1 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-500">
      404
    </span>
    <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">
      Page Not Found
    </h1>
    <p class="text-sm text-neutral-600 dark:text-neutral-400 max-w-sm mx-auto leading-relaxed font-normal">
      The path you requested does not exist or has been moved.
    </p>
    <div>
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-900 dark:text-neutral-100 hover:underline underline-offset-4"
      >
        <span>&larr;</span>
        <span>Return to home</span>
      </a>
    </div>
  </div>
</BaseLayout>
